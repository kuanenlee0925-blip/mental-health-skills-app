# Copy to backend/.env. Never commit the real file.
# demo uses clearly labeled deterministic fixtures and makes no external calls.
MODEL_MODE=demo
MODEL_API_KEY=
MODEL_NAME=
# Live requests use OpenRouter's HTTPS chat-completions API.
LIVE_CALL_LIMIT=50

# Optional class live-audio activity. No paid session starts automatically.
VOICE_ENABLED=false
OPENAI_API_KEY=
VOICE_LIVE_MODEL=gpt-live-1
VOICE_BACKEND_MODEL=gpt-6-luna
VOICE_MAX_SESSION_SECONDS=300
VOICE_SESSION_LIMIT=3
